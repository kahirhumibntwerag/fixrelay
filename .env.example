DATABASE_URL=
# Optional direct Neon connection for migrations.
DATABASE_URL_UNPOOLED=
# Human dashboard sign-in. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Set your canonical HTTPS URL in production; localhost for development.
BETTER_AUTH_URL=http://localhost:3000
# Optional legacy operator credential. Legacy writes otherwise need a signed-in
# human session or an account-wide agent key. Public reads remain anonymous.
MCP_WRITE_TOKEN=
# Optional: salt for anonymous write quota hashes; set in production.
RATE_LIMIT_SALT=
